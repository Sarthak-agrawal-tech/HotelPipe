generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id                  String   @id @default(cuid())
  ownerId             String   @unique
  name                String
  city                String
  state               String
  googleMapsLink      String?
  
  whatsappNumber      String   @unique
  secondaryNumbers    String?
  primaryLanguage     String   @default("hindi")
  focusArea           String   @default("wedding")
  teamSize            String   @default("solo")
  
  // Property Specs & Pricing
  roomCount           Int      @default(0)
  roomTypesAndPricing String?  @db.Text
  banquetPackages     String?  @db.Text
  amenities           String?  @db.Text
  
  // Policies & Notes
  checkInTime         String?
  checkOutTime        String?
  cancellationPolicy  String?  @db.Text
  faqs                String?  @db.Text
  
  createdAt           DateTime @default(now())

  // Relations
  leads               Lead[]
  media               HotelMedia[]
  // followups        FollowUp[] (Keep this if you already have it)
  followups           FollowUp[]
}

// NEW: Stores the labeled images for the AI to use
model HotelMedia {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String   // The Supabase Storage URL
  label     String   // The tag the user typed (e.g., "Banquet Hall 1")
  createdAt DateTime @default(now())
}

model Lead {
  id           String     @id @default(cuid())
  hotelId      String
  name         String
  phone        String
  source       LeadSource @default(WHATSAPP)
  inquiryType  String?
  eventDate    DateTime?
  guestCount   Int?
  notes        String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hotel        Hotel      @relation(fields: [hotelId], references: [id])
  followups    FollowUp[]
  messages     Message[]
}

model FollowUp {
  id          String         @id @default(cuid())
  hotelId     String
  leadId      String
  dayNumber   Int            // 1, 3, or 7
  status      FollowUpStatus @default(PENDING)
  scheduledAt DateTime
  sentAt      DateTime?
  message     String?
  createdAt   DateTime       @default(now())

  hotel       Hotel          @relation(fields: [hotelId], references: [id])
  lead        Lead           @relation(fields: [leadId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  leadId    String
  sender    String   // Will be 'USER' or 'AI'
  text      String
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id])
}

enum LeadSource {
  WHATSAPP
  CALL
  WALKIN
  EXCEL_IMPORT
}

enum LeadStatus {
  NEW
  INTERESTED
  WAITING
  FOLLOWUP_DUE
  BOOKED
  LOST
}

enum FollowUpStatus {
  PENDING
  SENT
  REPLIED
  SKIPPED
}
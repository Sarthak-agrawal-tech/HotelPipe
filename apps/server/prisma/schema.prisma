generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id              String   @id @default(cuid())
  name            String
  city            String
  state           String
  whatsappNumber  String   @unique
  primaryLanguage String   @default("hindi")
  focusArea       String   @default("wedding")
  createdAt       DateTime @default(now())

  leads           Lead[]
  followups       FollowUp[]
}

model Lead {
  id           String     @id @default(cuid())
  hotelId      String
  name         String
  phone        String
  source       LeadSource @default(WHATSAPP)
  inquiryType  String?
  eventDate    DateTime?
  guestCount   Int?
  notes        String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hotel        Hotel      @relation(fields: [hotelId], references: [id])
  followups    FollowUp[]
}

model FollowUp {
  id          String         @id @default(cuid())
  hotelId     String
  leadId      String
  dayNumber   Int            // 1, 3, or 7
  status      FollowUpStatus @default(PENDING)
  scheduledAt DateTime
  sentAt      DateTime?
  message     String?
  createdAt   DateTime       @default(now())

  hotel       Hotel          @relation(fields: [hotelId], references: [id])
  lead        Lead           @relation(fields: [leadId], references: [id])
}

enum LeadSource {
  WHATSAPP
  CALL
  WALKIN
  EXCEL_IMPORT
}

enum LeadStatus {
  NEW
  INTERESTED
  WAITING
  FOLLOWUP_DUE
  BOOKED
  LOST
}

enum FollowUpStatus {
  PENDING
  SENT
  REPLIED
  SKIPPED
}